<!DOCTYPE html>

<html lang="en" data-theme="light">

<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">

	<title>Bills Demo {% block title %}{% endblock %}</title>

    <link rel="icon" href="/static/images/note.svg">

    <script src="/static/js/utils.js"></script>

    <link rel="stylesheet" href="/static/css/reset.css">
    <link rel="stylesheet" href="/static/css/messages.css">
    <link rel="stylesheet" href="/static/css/styles.css">
</head>

<body>

   <header>
    <div class="logo">
        <a href="/"><img src="/static/images/bill-logo.png" alt="Company Logo"></a>
    </div>

    <nav>
        <ul class="nav-links">
            <li><a href="/bill/add">Add Bills</a></li>
            <li class="nav-balance">Remaining Budget:<a href="/"> <span>${{ remaining_budget if remaining_budget is defined else '0.00' }}</span></a></li>
        </ul>
    </nav>  
   </header>

    {% include "partials/messages.jinja" %}

    <main>

        {% block content %}
        {% endblock %}

    </main>

</body>

</html>