{#=====================================================
  Home page
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}

    <h2>Bills</h2>

    <section id="bills">

        {% for bill in bills %}

            <div class="bill {{ 'pinned' if bill.pinned }}">

                <header>
                    <h3>{{ bill.title }}</h3>
                    {{ "📌" if bill.pinned }}
                </header>

                <p>{{ bill.body | paragraphs }}</p>

                <footer>
                    <span>Created on {{ bill.created | local | format }}</span>
                    
                    <!-- Action Buttons -->
                    <div class="bill-actions" 
                    style="margin-top: 10px;
                    display: 
                    flex; 
                    gap: 10px;">

                    <!-- Edit Button -->
                    <a href="/bill/edit/{{ bill.id }}" class="btn-edit" 
                    style="text-decoration: none;">✏️ Edit</a>
                        
                    <!-- Delete Button (Wrapped in a form for POST security) -->
                    <form action="/bill/delete/{{ bill.id }}" 
                    method="POST" 
                    style="display:inline;" 
                    onsubmit="return confirm('Are you sure you want to delete this bill?');">

                    <button type="submit" class="btn-delete" 
                    style="background: none; 
                    border: none; 
                    color: #ff4d4d; 
                    cursor: pointer; 
                    padding: 0;">❌ Delete</button>
                    
                        </form>
                    </div>
                </footer>

            </div>

        {% else %}

            <p>No Notes!</p>

        {% endfor %}

    </section>

{% endblock %}

